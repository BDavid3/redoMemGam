<Window x:Class="redo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:redo"
        mc:Ignorable="d"
        Title="Rework Memory Game" Height="450" Width="800">
    <Grid x:Name="grd_mainGrid">
        <!-- Making the Width of the Columns-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Side Panel-->
        <StackPanel Grid.Column="0" Margin="10" Background="LightGray">
            <TextBlock Text="Size" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold"></TextBlock>
            <ListBox x:Name="lstbox_sizeListbox">
                <ListBoxItem Content="2x2" Tag="2"/>
                <ListBoxItem Content="4x4" Tag="4"/>
                <ListBoxItem Content="6x6" Tag="6"/>
            </ListBox>
            <TextBlock Text="Theme" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold"/>
            <ListBox x:Name="lstbox_themeListbox">
                <ListBoxItem Content="Numbers" Tag="numbers"/>
                <ListBoxItem Content="Smiley" Tag="smiley"/>
                <ListBoxItem Content="Country-Capital" Tag="countrycapital"/>
            </ListBox>
            <Button x:Name="btn_StartGame" Content="Start Game" FontSize="25" FontWeight="Bold" Background="Green" Margin="0,30,0,10" Click="Click_StartGameButton"/>
            <TextBlock x:Name="txtblock_attempts" Text="Attempts: 0" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="Red"/>
            <TextBlock x:Name="txtblock_status" Text="Press the Button to start the game" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="BlueViolet"/>
        </StackPanel>
        <!-- Right Side Panel-->
        <Grid x:Name="grd_gameGrid" Grid.Column="1" Margin="10" Background="LightGray"></Grid>
    </Grid>
</Window>
